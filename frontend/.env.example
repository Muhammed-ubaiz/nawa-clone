# Base URL of the backend REST API (no trailing slash).
# Uploaded blog/service images (/uploads/...) are loaded from this server's origin too.
#   .env             -> local development (npm run dev):  http://localhost:5000/api
#   .env.production  -> production build (npm run build): https://<your-backend-domain>/api
# Production builds fail on purpose if this is missing or points to localhost (see vite.config.js).
VITE_API_URL=http://localhost:5000/api
