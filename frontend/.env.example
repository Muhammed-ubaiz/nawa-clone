# Backend API base URL. Copy to .env for local development; on Vercel set it under
# Project → Settings → Environment Variables (it is baked in at build time, so redeploy after changing it).
# Either the server origin or its /api path works; a trailing slash is ignored.
#   Local:      http://localhost:5000/api
#   Production: https://api.yourdomain.com/api   (your Hostinger backend)
VITE_API_URL=http://localhost:5000/api
