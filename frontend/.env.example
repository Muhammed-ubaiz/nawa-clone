# Backend API base URL (VITE_API_URL). Either the server origin or its /api path works.
#   .env             -> local development (npm run dev):  http://localhost:5000/api
#   .env.production  -> production build (npm run build): https://nawa-clone.onrender.com
# On Vercel, a VITE_API_URL set in Project → Settings → Environment Variables takes precedence.
# Production builds fail on purpose if this is missing or points to localhost (vite.config.js).
VITE_API_URL=http://localhost:5000/api
