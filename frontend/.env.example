# Optional. The site talks to Firebase project nawaayurveda-9b51e directly (src/lib/firebase.js);
# no backend URL is needed. Set any of these only to point a build at a different Firebase project.
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=

# Timezone for today / this week / this month analytics boundaries (IANA zone name).
# VITE_CLINIC_TIMEZONE=Asia/Dubai
