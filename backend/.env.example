# Copy to .env for local development. On Render, set these under the service's Environment tab
# (render.yaml declares them; PORT is provided by Render automatically).

# Port to listen on. Render sets this itself; 5000 is the local default.
PORT=5000

# "production" on Render (hides internal error details from API responses).
NODE_ENV=development

# Required (MONGO_URI also accepted). MongoDB Atlas connection string WITH the database name, e.g.
# mongodb+srv://<db_username>:<db_password>@<cluster-host>.mongodb.net/nawa_ayurvedic?retryWrites=true&w=majority&appName=Cluster0
# In Atlas → Network Access, allow 0.0.0.0/0 (Render's outbound IPs are not fixed).
MONGODB_URI=

# Required. Long random string (32+ characters) used to sign admin login tokens.
JWT_SECRET=
JWT_EXPIRES_IN=1d

# Production frontend URL(s) allowed by CORS, comma-separated (localhost:5173 is always allowed).
# e.g. https://nawa-ayurveda.vercel.app
CLIENT_URL=

# Used for today / this week / this month analytics boundaries (IANA zone name)
CLINIC_TIMEZONE=Asia/Dubai

# Used only by `npm run seed-admin`
ADMIN_NAME=Clinic Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password
