PORT=5000
# MongoDB Atlas connection string (Atlas → Connect → Drivers), with the database name added:
# mongodb+srv://<db_username>:<db_password>@<cluster-host>.mongodb.net/nawa_ayurveda?retryWrites=true&w=majority&appName=Cluster0
MONGO_URI=
JWT_SECRET=
JWT_EXPIRES_IN=1d
CLIENT_URL=http://localhost:5173

# Used for today / this week / this month analytics boundaries (IANA zone name)
CLINIC_TIMEZONE=Asia/Dubai

# Used only by `npm run seed-admin`
ADMIN_NAME=Clinic Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password
