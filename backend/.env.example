# Copy to .env for local development. On the host (Hostinger, Render, ...), set these in its environment settings.
# Most Node hosts set PORT themselves; 5000 is used when it is not set.

PORT=5000

# "production" on the live server (hides internal error details from API responses).
NODE_ENV=development

# Required (MONGO_URI also accepted). MongoDB Atlas connection string WITH the database name, e.g.
# mongodb+srv://<db_username>:<db_password>@<cluster-host>.mongodb.net/nawa_ayurvedic?retryWrites=true&w=majority&appName=Cluster0
# In Atlas → Network Access, allow 0.0.0.0/0 (hosting providers' outbound IPs are not fixed).
MONGODB_URI=

# Required. Long random string (32+ characters) used to sign admin login tokens.
JWT_SECRET=
JWT_EXPIRES_IN=1d

# Production frontend URL(s) allowed by CORS, comma-separated (localhost:5173 and :3000 are always allowed).
# e.g. https://your-app-name.vercel.app,https://yourdomain.com
CLIENT_URL=https://your-app-name.vercel.app

# Used for today / this week / this month analytics boundaries (IANA zone name)
CLINIC_TIMEZONE=Asia/Dubai

# Used only by `npm run seed-admin`
ADMIN_NAME=Clinic Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password
