PORT=5000
JWT_SECRET=
JWT_EXPIRES_IN=1d
CLIENT_URL=http://localhost:5173

# --- Firebase / Firestore (use ONE of the credential options) ---
# 1) Path to the service-account key (Firebase console → Project settings → Service accounts →
#    Generate new private key). Relative to backend/ or absolute. Never commit this file.
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
# 2) Or the key's JSON itself (raw or base64) — handy on hosts without a file system.
# FIREBASE_SERVICE_ACCOUNT_JSON=
# 3) Or GOOGLE_APPLICATION_CREDENTIALS / FIRESTORE_EMULATOR_HOST (Application Default Credentials).
# Optional: overrides the project id taken from the key.
# FIREBASE_PROJECT_ID=

# Used for today / this week / this month analytics boundaries (IANA zone name)
CLINIC_TIMEZONE=Asia/Dubai

# Used only by `npm run seed-admin`
ADMIN_NAME=Clinic Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password

# Used only by the one-off `npm run migrate-firestore` (old MongoDB data → Firestore)
# SOURCE_MONGO_URI=
