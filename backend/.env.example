PORT=5000
MONGODB_URI=
JWT_SECRET=
JWT_EXPIRES_IN=1d
# Extra CORS origins, comma-separated. nawaayurveda.ae, www, the Firebase web.app URL and
# localhost:5173/3000 are always allowed (see server.js); list any others here.
FRONTEND_URL=http://localhost:5173

# Used for today / this week / this month analytics boundaries (IANA zone name)
CLINIC_TIMEZONE=Asia/Dubai

# Firebase Admin SDK (project nawaayurveda-9b51e) — see config/firebase.js. Use ONE of:
#   FIREBASE_SERVICE_ACCOUNT=   full service-account JSON (raw or base64) — recommended on Render
#   FIREBASE_CLIENT_EMAIL= + FIREBASE_PRIVATE_KEY=   (keep the key's \n escapes)
#   GOOGLE_APPLICATION_CREDENTIALS=/path/to/key.json
# Locally you can instead place backend/serviceAccountKey.json (git-ignored). Never commit keys.
FIREBASE_SERVICE_ACCOUNT=

# Used only by `npm run seed-admin`
ADMIN_NAME=Clinic Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password
