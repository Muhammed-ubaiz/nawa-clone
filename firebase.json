{
  "hosting": {
    "public": "frontend/dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "cleanUrls": true,
    "trailingSlash": false,
    "redirects": [
      {
        "source": "/app",
        "destination": "/",
        "type": 301
      }
    ],
    "rewrites": [
      {
        "source": "/admin",
        "destination": "/app.html"
      },
      {
        "source": "/admin/**",
        "destination": "/app.html"
      },
      {
        "source": "/blog/**",
        "destination": "/app.html"
      },
      {
        "source": "/services/**",
        "destination": "/app.html"
      },
      {
        "source": "/service/**",
        "destination": "/app.html"
      },
      {
        "source": "/contact-us",
        "destination": "/app.html"
      }
    ],
    "headers": [
      {
        "source": "/assets/*-*.@(js|css)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "regex": "^[^.]*$",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}
